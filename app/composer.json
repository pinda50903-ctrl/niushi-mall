{
    "name": "niushi/mall-backend",
    "type": "project",
    "description": "Niushi Mall SaaS backend - clean-room Yii2 implementation",
    "keywords": ["yii2", "mall", "saas"],
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-openssl": "*",
        "ext-mbstring": "*",
        "niushi/yii2-assets-stub": "*",
        "yiisoft/yii2": "~2.0.51",
        "yiisoft/yii2-redis": "~2.0.0",
        "yiisoft/yii2-queue": "~2.3.0",
        "yiisoft/yii2-httpclient": "~2.0.0",
        "firebase/php-jwt": "^6.10",
        "endroid/qr-code": "^4.8"
    },
    "require-dev": {},
    "autoload": {
        "psr-4": {
            "app\\": ""
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "stubs/*"
        },
        {
            "type": "composer",
            "url": "https://mirrors.aliyun.com/composer/"
        }
    ],
    "config": {
        "process-timeout": 1800,
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        },
        "platform": {
            "php": "8.1.0"
        }
    },
    "scripts": {}
}
